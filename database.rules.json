{
  "rules": {
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^([A-Z]{4}|[A-Z]{2}[0-9]{3})$/) && (!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 200000)"
      }
    },
    "presence": {
      "$room": {
        ".read": true,
        "$peer": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 4000"
        }
      }
    },
    "media": {
      "$id": {
        ".read": true,
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "!newData.exists() || $id.matches(/^[0-9a-f]{32}$/) && newData.child('d').isString() && newData.child('d').val().length < 2200000"
      }
    },
    "bs": {
      "$code": {
        ".read": true,
        "state": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 100000"
        },
        "hidden": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 5000"
        },
        "players": {
          "$pid": {
            ".write": true,
            ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 3000"
          }
        },
        "secret": {
          "$pid": {
            ".write": true,
            ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 3000"
          }
        }
      }
    },
    "sq": {
      "$code": {
        ".read": true,
        "state": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 100000"
        },
        "hidden": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 60000"
        },
        "players": {
          "$pid": {
            ".write": true,
            ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 3000"
          }
        }
      }
    },
    "mf": {
      "$code": {
        ".read": true,
        "state": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 100000"
        },
        "players": {
          "$pid": {
            ".write": true,
            ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 3000"
          }
        }
      }
    },
    "draw": {
      "$code": {
        ".read": true,
        "state": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 100000"
        },
        "hidden": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 5000"
        },
        "players": {
          "$pid": {
            ".write": true,
            ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 3000"
          }
        },
        "strokes": {
          ".write": true,
          "$s": {
            ".validate": "!newData.exists() || $s.matches(/^s[0-9]{4}$/) && newData.child('j').isString() && newData.child('j').val().length < 30000"
          }
        }
      }
    },
    "night": {
      "$code": {
        ".read": true,
        "state": {
          ".write": true,
          ".validate": "$code.matches(/^[A-Z]{4}$/) && (!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 30000)"
        },
        "players": {
          "$nid": {
            ".write": true,
            ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 500"
          }
        }
      }
    },
    "df": {
      "$code": {
        ".read": true,
        "state": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 100000"
        },
        "players": {
          "$pid": {
            ".write": true,
            ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 3000"
          }
        },
        "hidden": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 60000"
        }
      }
    },
    "stats": {
      ".read": "auth != null && auth.uid === 'z3oEQYnA4UgwcWDvPwt1upKRSy52'",
      "day": {
        "$d": {
          ".write": "newData.exists()",
          ".validate": "$d.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      },
      "week": {
        "$w": {
          ".write": "newData.exists()",
          ".validate": "$w.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      },
      "month": {
        "$m": {
          ".write": "newData.exists()",
          ".validate": "$m.matches(/^20[0-9][0-9]-[01][0-9]$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      },
      "game": {
        "$d": {
          ".validate": "$d.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
          "$g": {
            ".write": "newData.exists()",
            ".validate": "$g.matches(/^[a-z]{2,12}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        }
      }
    },
    "notice": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'z3oEQYnA4UgwcWDvPwt1upKRSy52'",
      ".validate": "newData.hasChildren(['t', 's', 'e']) && newData.child('t').isString() && newData.child('t').val().length > 0 && newData.child('t').val().length <= 300 && newData.child('s').isNumber() && newData.child('e').isNumber()",
      "$other": {
        ".validate": "$other === 't' || $other === 's' || $other === 'e'"
      }
    },
    "dev": {
      ".read": "auth != null && auth.uid === 'z3oEQYnA4UgwcWDvPwt1upKRSy52'",
      "$id": {
        ".write": "$id.matches(/^[a-z0-9]{16}$/)",
        ".validate": "newData.hasChildren(['l'])",
        "a": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "b": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "n": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "f": { ".validate": "newData.isNumber()" },
        "s": { ".validate": "newData.isNumber()" },
        "l": { ".validate": "newData.isNumber()" },
        "w": { ".validate": "newData.isNumber()" },
        "m": {
          "$k": { ".validate": "$k.matches(/^20[0-9][0-9]-[01][0-9]$/) && newData.isNumber()" }
        },
        "g": {
          "$k": { ".validate": "$k.matches(/^[a-z]{2,12}$/) && newData.isNumber()" }
        },
        "$other": { ".validate": false }
      }
    },
    "devname": {
      ".read": "auth != null && auth.uid === 'z3oEQYnA4UgwcWDvPwt1upKRSy52'",
      ".write": "auth != null && auth.uid === 'z3oEQYnA4UgwcWDvPwt1upKRSy52'",
      "$id": { ".validate": "$id.matches(/^[a-z0-9]{16}$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 40" }
    },
    "ban": {
      ".read": "auth != null && auth.uid === 'z3oEQYnA4UgwcWDvPwt1upKRSy52'",
      "$id": {
        ".read": true,
        ".write": "auth != null && auth.uid === 'z3oEQYnA4UgwcWDvPwt1upKRSy52'",
        ".validate": "$id.matches(/^[a-z0-9]{16}$/) && newData.hasChildren(['u'])",
        "u": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "tag": {
      ".read": "auth != null && auth.uid === 'z3oEQYnA4UgwcWDvPwt1upKRSy52'",
      "$id": {
        ".read": true,
        ".write": "auth != null && auth.uid === 'z3oEQYnA4UgwcWDvPwt1upKRSy52'",
        ".validate": "$id.matches(/^[a-z0-9]{16}$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
      }
    },
    "users": {
      ".read": "auth != null && auth.uid === 'z3oEQYnA4UgwcWDvPwt1upKRSy52'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "n": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "e": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "t": { ".validate": "newData.isNumber()" },
        "d": {
          "$id": { ".validate": "$id.matches(/^[a-z0-9]{16}$/) && newData.isBoolean()" }
        },
        "$other": { ".validate": false }
      }
    },
    "cfg": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'z3oEQYnA4UgwcWDvPwt1upKRSy52'",
      "hide": {
        "$g": { ".validate": "$g.matches(/^[a-z]{2,12}$/) && newData.isBoolean()" }
      },
      "me": {
        "t": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "img": { ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 60000" },
        "$other": { ".validate": false }
      },
      "$other": { ".validate": false }
    },
    "paper": {
      "$n": {
        ".read": true,
        "$id": {
          ".write": "$id.matches(/^[a-z0-9]{16}$/) && !data.exists()",
          ".validate": "$n.matches(/^[0-9]{1,4}$/) && newData.child('n').isString() && newData.child('n').val().length <= 60 && newData.child('s').val() >= 1 && newData.child('s').val() <= 86400",
          "n": { ".validate": true },
          "s": { ".validate": true },
          "at": { ".validate": true },
          "$other": { ".validate": false }
        }
      }
    },
    "mind": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{8}$/)",
        "j": {
          ".validate": "newData.isString() && newData.val().length < 50000"
        },
        "dots": {
          ".validate": "newData.isString() && newData.val().length < 50000"
        },
        "$game": {
          ".validate": "$game.matches(/^[a-z]{2,12}$/) && newData.isString() && newData.val().length < 50000"
        }
      }
    },
    "mindu": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{8}$/)"
      }
    }
  }
}
