{
  "rules": {
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^([A-Z]{4}|[A-Z]{2}[0-9]{3})$/) && (!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 200000)"
      }
    },
    "presence": {
      "$room": {
        ".read": true,
        "$peer": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 4000"
        }
      }
    },
    "media": {
      "$id": {
        ".read": true,
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "!newData.exists() || $id.matches(/^[0-9a-f]{32}$/) && newData.child('d').isString() && newData.child('d').val().length < 2200000"
      }
    },
    "bs": {
      "$code": {
        ".read": true,
        "state": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 100000"
        },
        "hidden": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 5000"
        },
        "players": {
          "$pid": {
            ".write": true,
            ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 3000"
          }
        },
        "secret": {
          "$pid": {
            ".write": true,
            ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 3000"
          }
        }
      }
    },
    "sq": {
      "$code": {
        ".read": true,
        "state": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 100000"
        },
        "hidden": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 60000"
        },
        "players": {
          "$pid": {
            ".write": true,
            ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 3000"
          }
        }
      }
    },
    "mf": {
      "$code": {
        ".read": true,
        "state": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 100000"
        },
        "players": {
          "$pid": {
            ".write": true,
            ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 3000"
          }
        }
      }
    },
    "draw": {
      "$code": {
        ".read": true,
        "state": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 100000"
        },
        "hidden": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 5000"
        },
        "players": {
          "$pid": {
            ".write": true,
            ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 3000"
          }
        },
        "strokes": {
          ".write": true,
          "$s": {
            ".validate": "!newData.exists() || $s.matches(/^s[0-9]{4}$/) && newData.child('j').isString() && newData.child('j').val().length < 30000"
          }
        }
      }
    },
    "night": {
      "$code": {
        ".read": true,
        "state": {
          ".write": true,
          ".validate": "$code.matches(/^[A-Z]{4}$/) && (!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 30000)"
        },
        "players": {
          "$nid": {
            ".write": true,
            ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 500"
          }
        }
      }
    },
    "df": {
      "$code": {
        ".read": true,
        "state": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 100000"
        },
        "players": {
          "$pid": {
            ".write": true,
            ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 3000"
          }
        },
        "hidden": {
          ".write": true,
          ".validate": "!newData.exists() || newData.child('j').isString() && newData.child('j').val().length < 60000"
        }
      }
    },
    "mind": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{8}$/)",
        "j": {
          ".validate": "newData.isString() && newData.val().length < 50000"
        },
        "dots": {
          ".validate": "newData.isString() && newData.val().length < 50000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "mindu": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{8}$/)"
      }
    }
  }
}
