{
"1": [
"جَدْي",
"ولد الماعز الصغير.",
"رعى الراعي الجَدْيَ بجانب أمّه."
],
"2": [
"عِلْم",
"معرفة الشيء على حقيقته.",
"طلبُ العلم يرفع صاحبه."
],
"3": [
"نِعَم",
"جمع نِعْمة، وهي الخير والفضل. أما «نَعَم» فحرف جواب.",
"عدّد نِعَمَ حياته من صحة وأهل وأصدقاء."
],
"4": [
"مِلْح",
"مادة بيضاء تُضاف إلى الطعام فتعطيه طعمه.",
"أضاف قليلًا من الملح إلى الأرز."
],
"5": [
"لَقَب",
"اسم يُعرف به الشخص غير اسمه الأصلي، أو اسم يُمنح للفائز.",
"فاز الفريق بلقب البطولة."
],
"6": [
"بِضْع",
"عدد من ثلاثة إلى تسعة.",
"انتظرته بِضْعَ دقائق."
],
"7": [
"عِوَض",
"البدل، وهو ما يُعطى مكان الشيء.",
"أخذ كتابًا جديدًا عِوَضًا عن الكتاب الضائع."
],
"8": [
"مَقَرّ",
"المكان الذي يستقر فيه الشيء أو تكون فيه الإدارة.",
"زار الوفدُ مقرَّ الشركة."
],
"9": [
"عَرْش",
"سرير الملك، ويُطلق على المُلك نفسه.",
"جلس الملك على العرش."
],
"10": [
"مُعَدّ",
"مُجهَّز ومُهيّأ لشيء.",
"الطعام مُعَدٌّ للضيوف."
],
"11": [
"مَلَأَ",
"جعل الإناء ونحوه ممتلئًا.",
"مَلَأَ الكوبَ ماءً."
],
"12": [
"رُبْع",
"جزء واحد من أربعة أجزاء متساوية.",
"قطع ربعَ المسافة في ساعة."
],
"13": [
"تَعَلُّم",
"اكتساب المعرفة أو المهارة.",
"التعلّم لا يتوقف عند عمر معيّن."
],
"14": [
"هُنَاك",
"اسم إشارة للمكان البعيد.",
"البيت هناك خلف الشجرة."
],
"15": [
"لَامِع",
"البرّاق الذي يعكس الضوء.",
"صار الحذاء لامعًا بعد تنظيفه."
],
"16": [
"مَكَان",
"الموضع الذي يكون فيه الشيء.",
"وجد مكانًا هادئًا للقراءة."
],
"17": [
"هَكَذَا",
"بهذه الطريقة وعلى هذا النحو.",
"هكذا تُحلّ المسألة."
],
"18": [
"تَوَقُّف",
"الامتناع عن الاستمرار في الشيء.",
"بعد تَوقُّف المطر خرج الأطفال للعب."
],
"19": [
"جَيِّد",
"حسن وطيّب، عكس الرديء.",
"كان عمله جيّدًا فشكره المعلّم."
],
"20": [
"مَعْنَى",
"المقصود من الكلام.",
"سأل عن معنى الكلمة."
],
"21": [
"فَرَكَ",
"دلك الشيء بيده.",
"فرك عينيه بعد النوم."
],
"22": [
"صَحِيح",
"السليم الخالي من الخطأ.",
"كانت إجاباته صحيحة كلها."
],
"23": [
"أُنَاس",
"جماعة من الناس.",
"التقى بأُناسٍ طيّبين في سفره."
],
"24": [
"غَرِيب",
"من ليس من أهل المكان، أو الشيء غير المألوف.",
"سمعنا صوتًا غريبًا في الليل."
],
"25": [
"صَبَاح",
"أول النهار.",
"خرج في الصباح الباكر."
],
"26": [
"ذَهَاب",
"المضيّ والانتقال من مكان إلى آخر.",
"كان الذهاب سهلًا والعودة صعبة."
],
"27": [
"حَادّ",
"القاطع، أو الشديد.",
"استعمل سكينًا حادًّا."
],
"28": [
"طِوَال",
"مدة الشيء كلها من أوله إلى آخره.",
"سهر طِوالَ الليل."
],
"29": [
"حُلَّة",
"الثوب الجديد الجميل.",
"ارتدى حُلّةً جديدة في العيد."
],
"30": [
"صَغِير",
"قليل الحجم أو السن، ضد الكبير.",
"سكن في بيت صغير قرب البحر."
],
"31": [
"سَعِيد",
"الفرِح المسرور.",
"كان سعيدًا بنجاحه في الاختبار."
],
"32": [
"جَار",
"من يسكن بقربك.",
"زارنا جارنا ومعه هدية."
],
"33": [
"مَلَكَة",
"صفة راسخة في النفس كالموهبة والقدرة. وتُقرأ «مَلِكَة» زوجة الملك.",
"عنده مَلَكةُ الحفظ السريع."
],
"34": [
"رِفْق",
"لين ولطف في المعاملة.",
"عامل الحيوان برفق."
],
"35": [
"مُدَرَّج",
"مكان بدرجات مرتفعة للجلوس، كما في الملاعب والجامعات.",
"امتلأ المدرّج بالجمهور."
],
"36": [
"رَيْب",
"الشكّ.",
"هذا أمرٌ لا ريبَ فيه."
],
"37": [
"كَمَال",
"التمام والخلوّ من النقص.",
"يسعى إلى الكمال في عمله."
],
"38": [
"طَرِيق",
"السبيل الذي يُمشى فيه.",
"الطريق إلى المزرعة طويل."
],
"39": [
"رَعْشَة",
"ارتجاف خفيف في الجسد.",
"أصابته رعشة من شدّة البرد."
],
"40": [
"صَرَفَ",
"أنفق المال، أو أبعد الشيء.",
"صرف راتبه على حاجات بيته."
],
"41": [
"سِرِّيّ",
"ما يُكتم ولا يُعلن.",
"هذه معلومات سريّة."
],
"42": [
"جَلِيّ",
"الواضح الظاهر.",
"الفرق بينهما جليٌّ."
],
"43": [
"سَمَاع",
"الاستماع إلى الصوت.",
"سرّه سماعُ الخبر."
],
"44": [
"مُحَال",
"الأمر الذي لا يمكن أن يكون.",
"من المحال أن يتأخر عن موعده."
],
"45": [
"طَيْف",
"الخيال الذي يُرى في المنام، وألوان الضوء المتتابعة.",
"ظهر طيفُ الألوان بعد المطر."
],
"46": [
"شُكْر",
"الثناء على المعروف.",
"قدّم الشكر لمعلّمه."
],
"47": [
"ثَرِيّ",
"الغنيّ صاحب المال الكثير.",
"تبرّع رجل ثريّ لبناء مدرسة."
],
"48": [
"عِيد",
"يوم الفرح الذي يعود كل سنة.",
"لبسنا ثيابًا جديدة يوم العيد."
],
"49": [
"مَوْعِد",
"الوقت أو المكان المتفق عليه للقاء.",
"وصل قبل الموعد بعشر دقائق."
],
"50": [
"سَاحِل",
"شاطئ البحر.",
"سكن قرب الساحل."
],
"51": [
"عِلَّة",
"المرض، أو السبب.",
"عرف الطبيبُ علّةَ الألم."
],
"52": [
"زَمَن",
"الوقت قليله وكثيره.",
"تغيّرت أحوال الناس مع الزمن."
],
"53": [
"جُنْدِيّ",
"فرد في الجيش.",
"وقف الجنديّ يحرس الحدود."
],
"54": [
"قَالَب",
"الإطار الذي يُصبّ فيه الشيء ليأخذ شكله.",
"صبّ الكعكة في قالب دائري."
],
"55": [
"رِفَاق",
"الأصحاب في الطريق أو العمل.",
"سافر مع رفاقه إلى البرّ."
],
"56": [
"كَاتِب",
"من يكتب، وصاحب الكتب والمقالات.",
"قرأ رواية لكاتب مشهور."
],
"57": [
"غُرَّة",
"أول الشيء، وغُرّة الشهر أول يوم فيه.",
"سافر في غُرّة الشهر."
],
"58": [
"مَحَلّ",
"المكان، ويُقال للدكان.",
"فتح محلًّا لبيع العطور."
],
"59": [
"مَصْنَع",
"مكان تُصنع فيه الأشياء.",
"يعمل في مصنع للأثاث."
],
"60": [
"شِعَار",
"علامة أو رسم يُعرف به شيء.",
"صمّم الطلاب شعارًا لناديهم."
],
"61": [
"أَمْر",
"الطلب بفعل شيء، وأيضًا الشأن والحال.",
"هذا أمرٌ مهم."
],
"62": [
"ثُلُث",
"جزء واحد من ثلاثة أجزاء متساوية.",
"قرأ ثُلُثَ الكتاب."
],
"63": [
"شَاي",
"شراب يُصنع من أوراق نبات مجففة تُنقع في الماء الحار.",
"شربنا الشاي بعد العشاء."
],
"64": [
"دِقَّة",
"الإتقان والضبط.",
"أنجز العمل بدقّة."
],
"65": [
"مَفَرّ",
"المهرب.",
"لا مفرّ من مواجهة المشكلة."
],
"66": [
"تَغْيِير",
"تحويل الشيء من حال إلى حال.",
"قرّر تغيير عاداته."
],
"67": [
"هَيِّن",
"السهل اليسير.",
"الأمر هيّن فلا تقلق."
],
"68": [
"يَرَقَة",
"الطور الأول من حياة الحشرة بعد خروجها من البيضة.",
"تتحوّل اليرقة إلى فراشة."
],
"69": [
"إِعَادَة",
"فعل الشيء مرة أخرى.",
"طلب المعلّم إعادة الواجب."
],
"70": [
"سِيرَة",
"قصة حياة الإنسان، والطريقة التي يعيش بها.",
"قرأ سيرة عالِمٍ مشهور."
],
"71": [
"مَجَرَّة",
"مجموعة ضخمة جدًّا من النجوم.",
"تقع الأرض في مجرّة درب التبانة."
],
"72": [
"ذَقَن",
"أسفل الوجه تحت الفم.",
"وضع يده تحت ذقنه وفكّر."
],
"73": [
"إِنْذَار",
"التحذير من خطر قادم.",
"انطلق جرس الإنذار."
],
"74": [
"كَافَّة",
"جميع.",
"حضر كافّة الطلاب."
],
"75": [
"نُجُوم",
"جمع نجم، وهي الأجرام المضيئة في السماء.",
"تلمع النجوم في الليل الصافي."
],
"76": [
"نِيَّة",
"القصد والعزم في القلب.",
"كانت نيّته طيبة."
],
"77": [
"مِائَة",
"العدد بعد التسعة والتسعين.",
"قرأ مائة صفحة."
],
"78": [
"غَنِيّ",
"صاحب المال الكثير، أو المستغني عن غيره.",
"الغنيّ من قنع بما عنده."
],
"79": [
"هُنَالِك",
"اسم يشير إلى مكان بعيد.",
"هنالك بيت صغير خلف التلّ."
],
"80": [
"شَيْخ",
"كبير السن، ويُطلق على كبير القوم وعلى العالِم.",
"استشار شيخَ القبيلة."
],
"81": [
"أَسْنَان",
"جمع سِنّ، وهي العظام البيضاء في الفم.",
"نظّف أسنانه قبل النوم."
],
"82": [
"مَقَال",
"كلام مكتوب في موضوع واحد يُنشر في جريدة أو موقع.",
"قرأ مقالًا عن الفضاء."
],
"83": [
"أَصْحَاب",
"جمع صاحب، وهو الرفيق أو المالك.",
"خرج مع أصحابه."
],
"84": [
"أَعْمَال",
"جمع عمل، وهو ما يقوم به الإنسان.",
"أنهى أعماله قبل العصر."
],
"85": [
"سُمُوّ",
"العلوّ والارتفاع، ويُقال لكبار القوم «صاحب السموّ».",
"سموّ الأخلاق يرفع صاحبه."
],
"86": [
"مَجْد",
"العزّ والشرف.",
"صنع الأبطال مجدَ وطنهم."
],
"87": [
"خَتَمَ",
"أنهى الشيء، أو طبع عليه ختمًا.",
"ختم الموظف الورقة."
],
"88": [
"عِبْرَة",
"الدرس المستفاد من حادثة.",
"في القصة عبرةٌ لمن يتأمل."
],
"89": [
"عَلِيم",
"كثير العلم واسع المعرفة.",
"كان شيخ القرية عليمًا بأخبار الناس."
],
"90": [
"مِيلَاد",
"وقت ولادة الإنسان.",
"احتفلوا بيوم ميلاده."
],
"91": [
"سَلَّة",
"وعاء من الخوص ونحوه توضع فيه الأشياء.",
"ملأ السلّة بالفاكهة."
],
"92": [
"نَقْص",
"قلّة الشيء عمّا يجب.",
"يعاني النبات من نقص الماء."
],
"93": [
"شَمَال",
"الجهة المقابلة للجنوب.",
"تقع المدينة في شمال البلاد."
],
"94": [
"زِمَام",
"الحبل الذي يُقاد به البعير، و«أخذ زمام الأمور» أي تولّاها.",
"أخذ زمامَ المبادرة."
],
"95": [
"مُتَّسَع",
"المكان أو الوقت الواسع.",
"لا متّسع من الوقت للتأجيل."
],
"96": [
"أَوَان",
"الوقت والحين.",
"آن الأوانُ لنبدأ."
],
"97": [
"فَأْل",
"الكلمة الطيبة يسمعها الإنسان فيستبشر بها.",
"سمع كلمة طيبة فأخذها فألًا حسنًا."
],
"98": [
"سُيُول",
"جمع سيل، وهو الماء الكثير الجاري بعد المطر.",
"جرت السيول في الوادي."
],
"99": [
"مُنْصِف",
"العادل الذي يعطي كل ذي حقّ حقّه.",
"كان حكمًا منصفًا."
],
"100": [
"تَنَاوُل",
"أخذ الطعام أو الدواء، أو التطرّق إلى موضوع.",
"تناول الغداء مع أسرته."
],
"101": [
"وَسَن",
"أول النوم، والنعاس الخفيف.",
"غلبه الوسنُ فأغمض عينيه."
],
"102": [
"مُفَوَّه",
"الفصيح القادر على الكلام البليغ.",
"كان خطيبًا مفوّهًا يأسر السامعين."
],
"103": [
"قَاع",
"الأرض المنخفضة المستوية، وأسفل الشيء.",
"استقر الحجر في قاع البئر."
],
"104": [
"مَعْدِن",
"مادة كالذهب والحديد تُستخرج من الأرض.",
"الذهب معدن ثمين."
],
"105": [
"قُبَّعَة",
"غطاء للرأس له حافة.",
"لبس قبعة تحميه من الشمس."
],
"106": [
"قَبِيلَة",
"جماعة من الناس من أصل واحد.",
"اجتمعت القبيلة في العيد."
],
"107": [
"مُرْتَفَع",
"مكان عالٍ من الأرض.",
"صعدنا مرتفعًا لنرى الوادي."
],
"108": [
"قَوَاعِد",
"جمع قاعدة، وهي الأساس الذي يُبنى عليه.",
"شرح المعلم قواعد اللعبة قبل أن نبدأ."
],
"109": [
"سَرْمَد",
"الدائم الذي لا ينقطع.",
"كان ليلًا سرمدًا لا ينتهي."
],
"110": [
"سَأَم",
"الملل والضجر.",
"أصابه السأم من الانتظار."
],
"111": [
"دِمَن",
"آثار الديار الباقية بعد رحيل أهلها.",
"وقف الشاعر على الدِّمن يتذكر أهلها."
],
"112": [
"رُقَاد",
"النوم.",
"استيقظ من رقادٍ طويل."
],
"113": [
"وَلَع",
"التعلّق الشديد بالشيء وحبّه.",
"عنده ولعٌ بالقراءة."
],
"114": [
"سَمَا",
"ارتفع وعلا.",
"سما بأخلاقه فوق الصغائر."
],
"115": [
"كَمَد",
"الحزن الشديد المكتوم.",
"عاش أيامًا في كمدٍ بعد الفراق."
],
"116": [
"لَمْحَة",
"نظرة سريعة.",
"ألقى لمحة على الكتاب."
],
"117": [
"سَفِين",
"المراكب التي تجري في البحر.",
"أبحرت السفين نحو الشاطئ."
],
"118": [
"بَأْس",
"القوة والشدة.",
"رجلٌ شديد البأس."
],
"119": [
"لَيْث",
"من أسماء الأسد.",
"زأر الليث في عرينه."
],
"120": [
"مُعْجِزَة",
"أمر خارق للعادة.",
"كانت نجاته من الحادث كالمعجزة."
],
"121": [
"مُحَيَّا",
"الوجه.",
"أشرق محيّاه بالابتسامة."
],
"122": [
"نَأْي",
"البُعد.",
"طال النأي عن الأحبّة."
],
"123": [
"أَسْمَاك",
"جمع سمك.",
"اشترينا أسماكًا طازجة من السوق."
],
"124": [
"رَوْع",
"الفزع والخوف.",
"هدّأ من روعه."
],
"125": [
"نَبْت",
"ما يخرج من الأرض من زرع.",
"ظهر النبت الأخضر بعد المطر."
],
"126": [
"طِبَاق",
"في البلاغة: الجمع بين الكلمة وضدها، مثل الليل والنهار.",
"بين «الليل» و«النهار» طباق."
],
"127": [
"حِقْبَة",
"مدة طويلة من الزمن.",
"عاشت البلاد حقبةً من الازدهار."
],
"128": [
