{
"1": [
"جَدْي",
"ولد الماعز الصغير.",
"رعى الراعي الجَدْيَ بجانب أمّه."
],
"2": [
"عِلْم",
"معرفة الشيء على حقيقته.",
"طلبُ العلم يرفع صاحبه."
],
"3": [
"نِعَم",
"جمع نِعْمة، وهي الخير والفضل. أما «نَعَم» فحرف جواب.",
"عدّد نِعَمَ حياته من صحة وأهل وأصدقاء."
],
"4": [
"جَيْب",
"فتحة في الثوب توضع فيها الأشياء الصغيرة.",
"وضع المفتاح في جيبه."
],
"5": [
"لَقَب",
"اسم يُعرف به الشخص غير اسمه الأصلي، أو اسم يُمنح للفائز.",
"فاز الفريق بلقب البطولة."
],
"6": [
"بِضْع",
"عدد من ثلاثة إلى تسعة.",
"انتظرته بِضْعَ دقائق."
],
"7": [
"عِوَض",
"البدل، وهو ما يُعطى مكان الشيء.",
"أخذ كتابًا جديدًا عِوَضًا عن الكتاب الضائع."
],
"8": [
"مَقَرّ",
"المكان الذي يستقر فيه الشيء أو تكون فيه الإدارة.",
"زار الوفدُ مقرَّ الشركة."
],
"9": [
"عَرْش",
"سرير الملك، ويُطلق على المُلك نفسه.",
"جلس الملك على العرش."
],
"10": [
"مُعَدّ",
"مُجهَّز ومُهيّأ لشيء.",
"الطعام مُعَدٌّ للضيوف."
],
"11": [
"مَلَأَ",
"جعل الإناء ونحوه ممتلئًا.",
"مَلَأَ الكوبَ ماءً."
],
"12": [
"رُبْع",
"جزء واحد من أربعة أجزاء متساوية.",
"قطع ربعَ المسافة في ساعة."
],
"13": [
"تَعَلُّم",
"اكتساب المعرفة أو المهارة.",
"التعلّم لا يتوقف عند عمر معيّن."
],
"14": [
"هُنَاك",
"اسم إشارة للمكان البعيد.",
"البيت هناك خلف الشجرة."
],
"15": [
"حَدِيث",
"الكلام، ويأتي أيضًا بمعنى الجديد.",
"دار حديثٌ ممتع بين الأصدقاء."
],
"16": [
"مَكَان",
"الموضع الذي يكون فيه الشيء.",
"وجد مكانًا هادئًا للقراءة."
],
"17": [
"هَكَذَا",
"بهذه الطريقة وعلى هذا النحو.",
"هكذا تُحلّ المسألة."
],
"18": [
"تَوَقُّف",
"الامتناع عن الاستمرار في الشيء.",
"بعد تَوقُّف المطر خرج الأطفال للعب."
],
"19": [
"جَدَّدَ",
"جعل الشيء جديدًا.",
"جدّد أثاث بيته."
],
"20": [
"مَعْنَى",
"المقصود من الكلام.",
"سأل عن معنى الكلمة."
],
"21": [
"فَرَكَ",
"دلك الشيء بيده.",
"فرك عينيه بعد النوم."
],
"22": [
"يَصِحّ",
"يكون صحيحًا أو لائقًا.",
"لا يصحّ أن تتأخر عن موعدك."
],
"23": [
"أُنَاس",
"جماعة من الناس.",
"التقى بأُناسٍ طيّبين في سفره."
],
"24": [
"يَرْغَب",
"يريد الشيء ويميل إليه.",
"يرغب في تعلّم لغة جديدة."
],
"25": [
"صَبَاح",
"أول النهار.",
"خرج في الصباح الباكر."
],
"26": [
"ذَهَاب",
"المضيّ والانتقال من مكان إلى آخر.",
"كان الذهاب سهلًا والعودة صعبة."
],
"27": [
"حَادّ",
"القاطع، أو الشديد.",
"استعمل سكينًا حادًّا."
],
"28": [
"طِوَال",
"مدة الشيء كلها من أوله إلى آخره.",
"سهر طِوالَ الليل."
],
"29": [
"حُلَّة",
"الثوب الجديد الجميل.",
"ارتدى حُلّةً جديدة في العيد."
],
"30": [
"يُصِرّ",
"يتمسك برأيه ولا يتراجع عنه.",
"يُصِرّ على إكمال عمله بنفسه."
],
"31": [
"يُسْعِد",
"يجعل غيره سعيدًا.",
"يُسعدني لقاؤك."
],
"32": [
"جَالَ",
"طاف في المكان وتنقّل فيه.",
"جال في الأسواق القديمة."
],
"33": [
"مَلَكَة",
"صفة راسخة في النفس كالموهبة والقدرة. وتُقرأ «مَلِكَة» زوجة الملك.",
"عنده مَلَكةُ الحفظ السريع."
],
"34": [
"قَادَ",
"تولّى أمر غيره وسار أمامه، أو ساق السيارة.",
"قاد السيارة بحذر."
],
"35": [
"مُدَرَّج",
"مكان بدرجات مرتفعة للجلوس، كما في الملاعب والجامعات.",
"امتلأ المدرّج بالجمهور."
],
"36": [
"رَيْب",
"الشكّ.",
"هذا أمرٌ لا ريبَ فيه."
],
"37": [
"كَمَال",
"التمام والخلوّ من النقص.",
"يسعى إلى الكمال في عمله."
],
"38": [
"يَطْرُق",
"يضرب الباب ونحوه ليُفتح له.",
"يطرق الباب قبل أن يدخل."
],
"39": [
"عِدَّة",
"عدد غير محدد من الأشياء.",
"زار المدينة عدّة مرات."
],
"40": [
"صَرَفَ",
"أنفق المال، أو أبعد الشيء.",
"صرف راتبه على حاجات بيته."
],
"41": [
"سِرِّيّ",
"ما يُكتم ولا يُعلن.",
"هذه معلومات سريّة."
],
"42": [
"جَلِيّ",
"الواضح الظاهر.",
"الفرق بينهما جليٌّ."
],
"43": [
"سَمَاع",
"الاستماع إلى الصوت.",
"سرّه سماعُ الخبر."
],
"44": [
"يُدِير",
"يتولى أمر الشيء وتنظيمه.",
"يدير المحلّ مع أخيه."
],
"45": [
"طَيْف",
"الخيال الذي يُرى في المنام، وألوان الضوء المتتابعة.",
"ظهر طيفُ الألوان بعد المطر."
],
"46": [
"شُكْر",
"الثناء على المعروف.",
"قدّم الشكر لمعلّمه."
],
"47": [
"ثَرِيّ",
"الغنيّ صاحب المال الكثير.",
"تبرّع رجل ثريّ لبناء مدرسة."
],
"48": [
"يُعَاد",
"يُكرَّر مرة ثانية.",
"يُعاد عرض البرنامج مساءً."
],
"49": [
"قِيَم",
"جمع قيمة، وهي المبادئ والأخلاق التي يؤمن بها الإنسان.",
"تربّى على قيم الصدق والأمانة."
],
"50": [
"سَاحِل",
"شاطئ البحر.",
"سكن قرب الساحل."
],
"51": [
"عِلَّة",
"المرض، أو السبب.",
"عرف الطبيبُ علّةَ الألم."
],
"52": [
"زَمَن",
"الوقت قليله وكثيره.",
"تغيّرت أحوال الناس مع الزمن."
],
"53": [
"جُنْدِيّ",
"فرد في الجيش.",
"وقف الجنديّ يحرس الحدود."
],
"54": [
"قَالَب",
"الإطار الذي يُصبّ فيه الشيء ليأخذ شكله.",
"صبّ الكعكة في قالب دائري."
],
"55": [
"رَافَقَ",
"صاحَبَ غيره ومشى معه.",
"رافق والده في رحلته."
],
"56": [
"كَاتِب",
"من يكتب، وصاحب الكتب والمقالات.",
"قرأ رواية لكاتب مشهور."
],
"57": [
"غُرَّة",
"أول الشيء، وغُرّة الشهر أول يوم فيه.",
"سافر في غُرّة الشهر."
],
"58": [
"رَفِيع",
"العالي المرتفع، وأيضًا الدقيق.",
"حصل على منصب رفيع."
],
"59": [
"مَصْنَع",
"مكان تُصنع فيه الأشياء.",
"يعمل في مصنع للأثاث."
],
"60": [
"شِعَار",
"علامة أو رسم يُعرف به شيء.",
"صمّم الطلاب شعارًا لناديهم."
],
"61": [
"أَمْر",
"الطلب بفعل شيء، وأيضًا الشأن والحال.",
"هذا أمرٌ مهم."
],
"62": [
"ثُلُث",
"جزء واحد من ثلاثة أجزاء متساوية.",
"قرأ ثُلُثَ الكتاب."
],
"63": [
"يَشَاء",
"يريد.",
"يفعل ما يشاء في وقت فراغه."
],
"64": [
"دِقَّة",
"الإتقان والضبط.",
"أنجز العمل بدقّة."
],
"65": [
"مَفَرّ",
"المهرب.",
"لا مفرّ من مواجهة المشكلة."
],
"66": [
"تَغْيِير",
"تحويل الشيء من حال إلى حال.",
"قرّر تغيير عاداته."
],
"67": [
"هَيِّن",
"السهل اليسير.",
"الأمر هيّن فلا تقلق."
],
"68": [
"يَرَقَة",
"الطور الأول من حياة الحشرة بعد خروجها من البيضة.",
"تتحوّل اليرقة إلى فراشة."
],
"69": [
"إِعَادَة",
"فعل الشيء مرة أخرى.",
"طلب المعلّم إعادة الواجب."
],
"70": [
"سِيرَة",
"قصة حياة الإنسان، والطريقة التي يعيش بها.",
"قرأ سيرة عالِمٍ مشهور."
],
"71": [
"مَجَرَّة",
"مجموعة ضخمة جدًّا من النجوم.",
"تقع الأرض في مجرّة درب التبانة."
],
"72": [
"ذَقَن",
"أسفل الوجه تحت الفم.",
"وضع يده تحت ذقنه وفكّر."
],
"73": [
"إِنْذَار",
"التحذير من خطر قادم.",
"انطلق جرس الإنذار."
],
"74": [
"كَافَّة",
"جميع.",
"حضر كافّة الطلاب."
],
"75": [
"نُجُوم",
"جمع نجم، وهي الأجرام المضيئة في السماء.",
"تلمع النجوم في الليل الصافي."
],
"76": [
"نِيَّة",
"القصد والعزم في القلب.",
"كانت نيّته طيبة."
],
"77": [
"مِائَة",
"العدد بعد التسعة والتسعين.",
"قرأ مائة صفحة."
],
"78": [
"غَنِيّ",
"صاحب المال الكثير، أو المستغني عن غيره.",
"الغنيّ من قنع بما عنده."
],
"79": [
"نَالَ",
"حصل على الشيء.",
"نال جائزة التفوق."
],
"80": [
"شَيْخ",
"كبير السن، ويُطلق على كبير القوم وعلى العالِم.",
"استشار شيخَ القبيلة."
],
"81": [
"أَسْنَان",
"جمع سِنّ، وهي العظام البيضاء في الفم.",
"نظّف أسنانه قبل النوم."
],
"82": [
"تَحْدِيث",
"جعل الشيء حديثًا ومواكبًا لما استجد.",
"وصل تحديث جديد للتطبيق."
],
"83": [
"أَصْحَاب",
"جمع صاحب، وهو الرفيق أو المالك.",
"خرج مع أصحابه."
],
"84": [
"يُحَقِّق",
"يُنجز الشيء ويجعله واقعًا، أو يبحث في القضية.",
"يحقّق حلمه بالاجتهاد."
],
"85": [
"سُمُوّ",
"العلوّ والارتفاع، ويُقال لكبار القوم «صاحب السموّ».",
"سموّ الأخلاق يرفع صاحبه."
],
"86": [
"مَجْد",
"العزّ والشرف.",
"صنع الأبطال مجدَ وطنهم."
],
"87": [
"خَتَمَ",
"أنهى الشيء، أو طبع عليه ختمًا.",
"ختم الموظف الورقة."
],
"88": [
"عِبْرَة",
"الدرس المستفاد من حادثة.",
"في القصة عبرةٌ لمن يتأمل."
],
"89": [
"رُكُود",
"السكون وعدم الحركة، كركود الماء أو السوق.",
"أصاب السوقَ ركودٌ."
],
"90": [
"يَدُلّ",
"يُرشد ويُشير إلى الشيء.",
"يدلّ السائح على الطريق."
],
"91": [
"سَلَّة",
"وعاء من الخوص ونحوه توضع فيه الأشياء.",
"ملأ السلّة بالفاكهة."
],
"92": [
"نَقْص",
"قلّة الشيء عمّا يجب.",
"يعاني النبات من نقص الماء."
],
"93": [
"حَقِيقِيّ",
"الصادق الواقعي غير المزيّف.",
"هذا ذهبٌ حقيقي."
],
"94": [
"زِمَام",
"الحبل الذي يُقاد به البعير، و«أخذ زمام الأمور» أي تولّاها.",
"أخذ زمامَ المبادرة."
],
"95": [
"مُتَّسَع",
"المكان أو الوقت الواسع.",
"لا متّسع من الوقت للتأجيل."
],
"96": [
"أَوَان",
"الوقت والحين.",
"آن الأوانُ لنبدأ."
],
"97": [
"فَأْل",
"الكلمة الطيبة يسمعها الإنسان فيستبشر بها.",
"سمع كلمة طيبة فأخذها فألًا حسنًا."
],
"98": [
"سُيُول",
"جمع سيل، وهو الماء الكثير الجاري بعد المطر.",
"جرت السيول في الوادي."
],
"99": [
"مُنْصِف",
"العادل الذي يعطي كل ذي حقّ حقّه.",
"كان حكمًا منصفًا."
],
"100": [
"تَنَاوُل",
"أخذ الطعام أو الدواء، أو التطرّق إلى موضوع.",
"تناول الغداء مع أسرته."
],
"101": [
"وَسَن",
"أول النوم، والنعاس الخفيف.",
"غلبه الوسنُ فأغمض عينيه."
],
"102": [
"مُفَوَّه",
"الفصيح القادر على الكلام البليغ.",
"كان خطيبًا مفوّهًا يأسر السامعين."
],
"103": [
"قَاع",
"الأرض المنخفضة المستوية، وأسفل الشيء.",
"استقر الحجر في قاع البئر."
],
"104": [
"دَنَا",
"اقترب.",
"دنا موعد السفر."
],
"105": [
"قَطًا",
"طائر صحراوي يشبه الحمام، يُضرب به المثل في معرفة الطريق.",
"يرد القطا الماء في الصباح الباكر."
],
"106": [
"عَلَا",
"ارتفع.",
"علا صوت الجمهور."
],
"107": [
"هَتَّان",
"المطر المتتابع الغزير.",
"نزل مطر هتّان على الوادي."
],
"108": [
"لَاحَ",
"ظهر وبدا من بعيد.",
"لاح الفجر في الأفق."
],
"109": [
"سَرْمَد",
"الدائم الذي لا ينقطع.",
"كان ليلًا سرمدًا لا ينتهي."
],
"110": [
"سَأَم",
"الملل والضجر.",
"أصابه السأم من الانتظار."
],
"111": [
"دِمَن",
"آثار الديار الباقية بعد رحيل أهلها.",
"وقف الشاعر على الدِّمن يتذكر أهلها."
],
"112": [
"رُقَاد",
"النوم.",
"استيقظ من رقادٍ طويل."
],
"113": [
"وَلَع",
"التعلّق الشديد بالشيء وحبّه.",
"عنده ولعٌ بالقراءة."
],
"114": [
"سَمَا",
"ارتفع وعلا.",
"سما بأخلاقه فوق الصغائر."
],
"115": [
"كَمَد",
"الحزن الشديد المكتوم.",
"عاش أيامًا في كمدٍ بعد الفراق."
],
"116": [
"شَمَّرَ",
"رفع كُمّه أو ثوبه استعدادًا للعمل، وجدّ فيه.",
"شمّر عن ساعديه وبدأ العمل."
],
"117": [
"سَفِين",
"المراكب التي تجري في البحر.",
"أبحرت السفين نحو الشاطئ."
],
"118": [
"بَأْس",
"القوة والشدة.",
"رجلٌ شديد البأس."
],
"119": [
"لَيْث",
"من أسماء الأسد.",
"زأر الليث في عرينه."
],
"120": [
"كَبَا",
"تعثّر وسقط على وجهه.",
"كبا الفرس ثم نهض."
],
"121": [
"مُحَيَّا",
"الوجه.",
"أشرق محيّاه بالابتسامة."
],
"122": [
"نَأْي",
"البُعد.",
"طال النأي عن الأحبّة."
],
"123": [
"سَادَ",
"صار سيّدًا، أو عمّ وانتشر.",
"ساد الهدوء في القاعة."
],
"124": [
"رَوْع",
"الفزع والخوف.",
"هدّأ من روعه."
],
"125": [
"سَنَام",
"الحدبة المرتفعة على ظهر الجمل.",
"للجمل العربي سنامٌ واحد."
],
"126": [
"طِبَاق",
"في البلاغة: الجمع بين الكلمة وضدها، مثل الليل والنهار.",
"بين «الليل» و«النهار» طباق."
],
"127": [
"حِقْبَة",
"مدة طويلة من الزمن.",
"عاشت البلاد حقبةً من الازدهار."
],
"128": [
"عُبُوس",
"تقطيب الوجه من الغضب أو الحزن.",
"علا وجهه العبوس."
],
"129": [
"صَالَ",
"هجم ووثب على خصمه.",
"صال الفارس وجال في الميدان."
],
"130": [
"مَاجَ",
"اضطرب وتحرّك مثل الموج.",
"ماج الناس في الساحة."
],
"131": [
"تَوْق",
"الاشتياق والنزوع إلى الشيء.",
"في قلبه توقٌ إلى الوطن."
],
"132": [
"عَبَق",
"الرائحة الطيبة التي تنتشر.",
"ملأ عبقُ القهوة المجلس."
],
"133": [
"وَدْق",
"المطر.",
"نزل الودق على الأرض العطشى."
],
"134": [
"رَامَ",
"طلب وأراد.",
"نال ما رام من العلم."
],
"135": [
"عَتِيد",
"الحاضر المهيّأ، والثابت القوي.",
"ينتظره مستقبل عتيد."
],
"136": [
"أُوَار",
"شدة الحرّ ولهب النار.",
"اشتد أوار الصيف."
],
"137": [
"سَمْت",
"الهيئة الحسنة في المظهر والسلوك.",
"كان حسن السمت وقورًا."
],
"138": [
"وَرَع",
"التحرّج والابتعاد عن الشبهات.",
"عُرف بالورع والتقوى."
],
"139": [
"سَنًا",
"الضوء والنور.",
"لمع سنا البرق."
],
"140": [
"دَامِس",
"الشديد الظلمة.",
"سار في ليلٍ دامس."
],
"141": [
"رَبْع",
"الدار والمنزل، وأهل الدار.",
"عاد إلى ربعه بعد غياب."
],
"142": [
"رَنَا",
"أدام النظر بسكون.",
"رنا إلى الأفق طويلًا."
],
"143": [
"خَبَا",
"خمد وانطفأ.",
"خبا ضوء المصباح."
],
"144": [
"كَلَأ",
"العشب والمرعى.",
"رعت الإبل الكلأ."
],
"145": [
"عُلَمَاء",
"جمع عالِم، وهو صاحب العلم الواسع.",
"اجتمع العلماء في المؤتمر."
],
"146": [
"جَزَع",
"قلة الصبر والخوف الشديد.",
"لم يظهر عليه الجزع رغم الشدة."
],
"147": [
"وَشَل",
"الماء القليل يتحلّب من صخر أو جبل.",
"شرب المسافر من وشلٍ في الجبل."
],
"148": [
"عَائِلَة",
"الأسرة: الرجل وزوجته وأولادهما.",
"اجتمعت العائلة في العيد."
],
"149": [
"عَنَا",
"خضع وذلّ.",
"عنا الجبابرة للحق."
],
"150": [
"كَمِيّ",
"الفارس الشجاع المتغطّي بسلاحه.",
"برز الكميّ إلى الميدان."
],
"151": [
"تَرَيَّثَ",
"تمهّل وأبطأ.",
"تريّث قبل أن يقرّر."
],
"152": [
"يَمَام",
"نوع من الحمام البري.",
"هدل اليمام على الأغصان."
],
"153": [
"أَرَاك",
"شجر تُتخذ من أغصانه المساويك.",
"قطع عودًا من الأراك."
],
"154": [
"وَصَب",
"المرض والتعب الدائم.",
"أنهكه الوصب."
],
"155": [
"دَافِق",
"المتدفّق بشدة.",
"جرى نهر دافق."
],
"156": [
"بُكْرَة",
"أول النهار.",
"خرجوا بكرةً إلى العمل."
],
"157": [
"نَاصِع",
"الخالص الشديد البياض أو الوضوح.",
"لبس ثوبًا ناصع البياض."
],
"158": [
"رَوِيّ",
"الحرف الذي تُبنى عليه القافية في الشعر.",
"رويّ القصيدة حرف اللام."
],
"159": [
"سَلَا",
"نسي الهمّ وطابت نفسه.",
"سلا عن أحزانه بمرور الأيام."
],
"160": [
"حَصِيف",
"المحكم العقل الجيّد الرأي.",
"رجل حصيف لا يتسرّع."
],
"161": [
"عَبِير",
"الرائحة الزكية.",
"فاح عبير الورد."
],
"162": [
"مُزْن",
"السحاب الممطر.",
"هطل المزن على الصحراء."
],
"163": [
"مَسَاء",
"آخر النهار وأول الليل.",
"تنزّهوا في المساء."
],
"164": [
"حُسَام",
"السيف القاطع.",
"شهر الفارس حسامه."
],
"165": [
"بَاز",
"طائر جارح يُصاد به.",
"أطلق الصقّار البازَ."
],
"166": [
"أَلَق",
"اللمعان والبريق.",
"في عينيه ألق."
],
"167": [
"أَيْنَ",
"اسم استفهام عن المكان.",
"أين وضعتَ مفاتيحك؟"
],
"168": [
"مَلِيح",
"الحسن الجميل.",
"له وجه مليح."
],
"169": [
"وَجَل",
"الخوف.",
"دخل وفي قلبه وجل."
],
"170": [
"سَعَادَة",
"الفرح وطيب النفس وراحة البال.",
"السعادة في القناعة."
],
"171": [
"مُقْلَة",
"شحمة العين التي تجمع السواد والبياض.",
"دمعت مقلتاه."
],
"172": [
"جُمَان",
"اللؤلؤ، أو حبّات من الفضة مثل اللؤلؤ.",
"تناثر الندى كالجمان."
],
"173": [
"تَسْلِيم",
"إعطاء الشيء لصاحبه.",
"تمّ تسليم الجوائز للفائزين."
],
"174": [
"كِمَام",
"أغلفة الزهر قبل أن يتفتّح.",
"تفتّحت الأزهار من كمامها."
],
"175": [
"وَسْمِيّ",
"أول مطر الربيع.",
"أنبت الوسميّ العشب."
],
"176": [
"بَشَرَة",
"ظاهر جلد الإنسان.",
"للشمس أثر على البشرة."
],
"177": [
"شَدَا",
"غنّى وترنّم.",
"شدا الطائر عند الفجر."
],
"178": [
"مُبَارَاة",
"منافسة بين فريقين أو لاعبين.",
"انتهت المباراة بالتعادل."
],
"179": [
"أَجَمَة",
"الشجر الكثيف الملتفّ.",
"اختبأ الأسد في الأجمة."
],
"180": [
"غَدَاة",
"أول النهار، ما بين الفجر وطلوع الشمس.",
"خرجوا غداةً إلى البر."
],
"181": [
"سَقَم",
"المرض.",
"شُفي من سقمه."
],
"182": [
"مَرَام",
"المطلوب والمقصود.",
"بلغ مرامه بعد تعب."
],
"183": [
"ثُلَّة",
"جماعة من الناس.",
"اجتمع ثلّة من الأصدقاء."
],
"184": [
"قَبَس",
"شعلة من نار تؤخذ من نار كبيرة.",
"أخذ قبسًا من النار."
],
"185": [
"عِيس",
"الإبل البيض.",
"سارت العيس في الصحراء."
],
"186": [
"هَجَا",
"ذمّ غيره بالشعر.",
"هجا الشاعر خصمه."
],
"187": [
"ثِمَاد",
"الماء القليل الذي لا يدوم.",
"لم يبقَ في الوادي إلا ثماد."
],
"188": [
"مُرَاقِب",
"من يلاحظ ويتابع ما يجري.",
"وقف المراقب في قاعة الامتحان."
],
"189": [
"لَحْظَة",
"زمن قصير جدًّا، بمقدار لمح البصر.",
"انتظر لحظةً ثم دخل."
],
"190": [
"هَجْر",
"ترك الشيء والإعراض عنه.",
"طال الهجر بين الصديقين."
],
"191": [
"لَوْحَة",
"صفيحة من خشب أو غيره يُكتب أو يُرسم عليها.",
"علّق لوحةً جميلة على الجدار."
],
"192": [
"نَسَمَة",
"ريح لطيفة.",
"هبّت نسمة باردة."
],
"193": [
"بُهِتَ",
"دُهش وتحيّر فلم ينطق.",
"بُهت الحاضرون من المفاجأة."
],
"194": [
"هُمَام",
"العظيم الهمّة الشجاع السخي.",
"كان قائدًا همامًا."
],
"195": [
"مُقَاطَعَة",
"قطع حديث غيرك قبل أن يُتمّه، أو الامتناع عن التعامل مع أحد.",
"المقاطعة تُزعج المتحدث."
],
"196": [
"بَتَّار",
"القاطع، ويوصف به السيف.",
"حمل سيفًا بتّارًا."
],
"197": [
"صَلَف",
"التكبّر والتعالي.",
"عُرف بالصلف والغرور."
],
"198": [
"مِشْكَاة",
"فتحة في الحائط يوضع فيها المصباح.",
"وضع السراج في المشكاة."
],
"199": [
"أَنَاة",
"الحلم والتمهّل وعدم العجلة.",
"في الأناة السلامة."
],
"200": [
"قِفَار",
"جمع قفر، وهي الأرض الخالية.",
"عبروا قفارًا واسعة."
],
"201": [
"أَبِيّ",
"الذي يأبى الذلّ ويترفّع عنه.",
"رجل أبيّ النفس."
],
"202": [
"وَارِف",
"الواسع الممتد، ويوصف به الظل.",
"جلس تحت ظلٍّ وارف."
],
"203": [
"كِنَايَة",
"التعبير عن معنى بلفظ يدل عليه دون تصريح.",
"«كثير الرماد» كناية عن الكرم."
],
"204": [
"نُهَيْر",
"نهر صغير.",
"جرى نُهيرٌ بين البساتين."
],
"205": [
"سَجْع",
"توافق أواخر الجمل في النثر.",
"في الخطبة سجع جميل."
],
"206": [
"وَجْد",
"الحب الشديد والحزن.",
"أضناه الوجد."
],
"207": [
"كُنْه",
"حقيقة الشيء وجوهره.",
"أدرك كنه المسألة."
],
"208": [
"نَعَام",
"طائر كبير لا يطير، سريع العدو.",
"ركض النعام في الصحراء."
],
"209": [
"رَخَم",
"طائر كبير من الجوارح.",
"حلّق الرخم فوق الجبل."
],
"210": [
"جِيد",
"العنق.",
"زيّنت جيدها بعقد."
],
"211": [
"احْتِمَال",
"توقّع حدوث الشيء، أو الصبر على الأذى.",
"هناك احتمال لسقوط المطر."
],
"212": [
"نَعَقَ",
"صاح الغراب.",
"نعق الغراب فوق الشجرة."
],
"213": [
"أَرَب",
"الحاجة والغاية.",
"قضى أربه وعاد."
],
"214": [
"كَهْل",
"من جاوز الثلاثين وظهر فيه الشيب.",
"رجل كهل وقور."
],
"215": [
"كَمْأَة",
"نبات ينبت تحت الأرض في الصحراء بعد المطر، ويُسمى الفقع.",
"خرجوا يجمعون الكمأة."
],
"216": [
"نَفَر",
"جماعة من الناس من الثلاثة إلى العشرة.",
"جاء نفرٌ من القوم."
],
"217": [
"تَجَمُّع",
"اجتماع الناس في مكان.",
"تجمّع الناس حول الفائز."
],
"218": [
"شِيَم",
"الأخلاق والطباع الأصيلة.",
"من شيم العرب الكرم."
],
"219": [
"وَطَر",
"الحاجة.",
"قضى وطره من السفر."
],
"220": [
"صَيِّب",
"المطر الغزير.",
"نزل مطرٌ صيّب."
],
"221": [
"غَسَق",
"أول ظلمة الليل.",
"عادوا عند الغسق."
],
"222": [
"صَرْح",
"البناء العالي الفخم.",
"شُيّد صرحٌ للعلم."
],
"223": [
"عَرِيق",
"الأصيل القديم.",
"لهذه المدينة تاريخ عريق."
],
"224": [
"عَنَت",
"المشقّة والشدة.",
"لقي العنت في سفره."
],
"225": [
"سَدِيم",
"الضباب الرقيق، وسحابة من الغبار والغاز في الفضاء.",
"رأى العلماء سديمًا بعيدًا."
],
"226": [
"بَهَاء",
"الحسن والجمال.",
"ازدانت المدينة ببهاء الأنوار."
],
"227": [
"مُقَارَنَة",
"النظر في شيئين لمعرفة ما بينهما من شبه واختلاف.",
"أجرى مقارنةً بين الكتابين."
],
"228": [
"رُطَب",
"التمر قبل أن يجفّ.",
"قدّم لضيوفه الرطب."
],
"229": [
"مَشْفَى",
"المكان الذي يُعالج فيه المرضى.",
"نُقل إلى المشفى."
],
"230": [
"تَلِيد",
"القديم الموروث.",
"للأمة مجد تليد."
],
"231": [
"مِرْسَاة",
"أداة ثقيلة تُلقى في الماء لتثبيت السفينة.",
"ألقى البحارة المرساة."
],
"232": [
"وَقَار",
"الرزانة والهيبة.",
"مشى بوقارٍ وهدوء."
],
"233": [
"فَلَاة",
"الصحراء الواسعة.",
"تاه في فلاةٍ لا ماء فيها."
],
"234": [
"أُنْس",
"الألفة وطمأنينة القلب.",
"وجد الأنس بين أهله."
],
"235": [
"حَتْمِيّ",
"الذي لا بدّ منه.",
"النجاح حتميّ مع الاجتهاد."
],
"236": [
"مِيسَم",
"أداة الوسم، وأثر الجمال.",
"على وجهه ميسم الحسن."
],
"237": [
"صَيَّاد",
"من يصطاد السمك أو الطير.",
"خرج الصيّاد إلى البحر."
],
"238": [
"رِهَام",
"المطر الخفيف الدائم.",
"نزل رهام الشتاء."
],
"239": [
"تَعِيس",
"الشقيّ الحزين.",
"بدا وجهه تعيسًا."
],
"240": [
"لَسِن",
"الفصيح البليغ الكلام.",
"خطيبٌ لَسِن."
],
"241": [
"مُهْجَة",
"الروح والقلب.",
"فداه بمهجته."
],
"242": [
"نَمِير",
"الماء العذب الصافي.",
"شرب من نبعٍ نمير."
],
"243": [
"جُرْعَة",
"ما يُشرب مرة واحدة، أو مقدار الدواء.",
"أخذ جرعة الدواء."
],
"244": [
"رَغَا",
"صوّت البعير.",
"رغا البعير طالبًا الماء."
],
"245": [
"عَاتِق",
"ما بين المنكب والعنق.",
"حمل المسؤولية على عاتقه."
],
"246": [
"نَسَفَ",
"هدم الشيء واقتلعه من أصله.",
"نسفت الريحُ الرمالَ."
],
"247": [
"لَقَطَات",
"جمع لقطة، وهي صورة أو مشهد قصير.",
"عرض لقطات من المباراة."
],
"248": [
"يُقِيم",
"يسكن في المكان، أو يعقد الحفل ونحوه.",
"يقيم في جدة منذ سنوات."
],
"249": [
"مُمِلّ",
"الذي يُشعر بالضجر.",
"كان الانتظار مملًّا."
],
"250": [
"دِيمَة",
"مطر يدوم في سكون.",
"هطلت ديمة طوال الليل."
],
"251": [
"مَاكِر",
"المخادع المحتال.",
"كان الثعلب ماكرًا في الحكاية."
],
"252": [
"نَدِيم",
"الرفيق في المجلس والحديث.",
"كان نديمه في السمر."
],
"253": [
"غِنَاء",
"ترديد الكلام بصوت مُلحَّن.",
"سمع غناءً شعبيًا في الحفل."
],
"254": [
"غَلَّة",
"الدخل من زرع أو ثمر أو تجارة.",
"جمع الفلاح غلّة أرضه."
],
"255": [
"شَهَامَة",
"النخوة والإقدام لنصرة غيرك.",
"ساعد الغريب بشهامة."
],
"256": [
"بَلَجَ",
"أشرق ووضح.",
"بلج الصبح وظهر."
],
"257": [
"ضَيْم",
"الظلم والقهر.",
"أبى أن يقبل الضيم."
],
"258": [
"مُهْرَة",
"ولد الفرس الأنثى.",
"ربّى مهرةً أصيلة."
],
"259": [
"لُجَّة",
"معظم الماء وأعمقه.",
"غاص في لجّة البحر."
],
"260": [
"قَيْظ",
"شدة حرّ الصيف.",
"اشتدّ القيظ في الظهيرة."
],
"261": [
"صَلَاحِيَة",
"المدة التي يبقى فيها الشيء صالحًا، أو الأهلية لفعل شيء.",
"انتهت صلاحية الحليب."
],
"262": [
"جَلَد",
"الصبر والقوة على التحمّل.",
"واجه المصاعب بجلد."
],
"263": [
"قَلِيب",
"البئر القديمة.",
"استقى من القليب."
],
"264": [
"عَرِين",
"مأوى الأسد.",
"عاد الأسد إلى عرينه."
],
"265": [
"مُسْتَشَار",
"من يُؤخذ رأيه في الأمور.",
"استعان المدير بمستشار."
],
"266": [
"مُطَابِق",
"الموافق للشيء تمامًا.",
"جاء الجواب مطابقًا للسؤال."
],
"267": [
"فُرَات",
"الماء العذب جدًّا.",
"شرب ماءً فراتًا."
],
"268": [
"خَاتَم",
"حلقة تُلبس في الإصبع.",
"لبس خاتمًا من فضة."
],
"269": [
"وَاصَلَ",
"استمر ولم يتوقف.",
"واصل السير حتى وصل."
],
"270": [
"حُوَار",
"ولد الناقة الصغير.",
"تبع الحُوارُ أمه."
],
"271": [
"مُسْتَوْدَع",
"مكان واسع تُحفظ فيه البضائع.",
"خزّن البضائع في المستودع."
],
"272": [
"سَنَاء",
"الرفعة وعلوّ المنزلة.",
"نال المجد والسناء."
],
"273": [
"كِنَاس",
"بيت الظبي بين الشجر.",
"عاد الظبي إلى كناسه."
],
"274": [
"لَاذَ",
"لجأ واحتمى.",
"لاذ بالظلّ من الحر."
],
"275": [
"اخْتَالَ",
"تكبّر وتبختر في مشيته.",
"اختال الطاووس بريشه."
],
"276": [
"سَجَا",
"سكن وهدأ، ويوصف به الليل إذا هدأ.",
"سجا الليل وهدأ كل شيء."
],
"277": [
"وَسِيم",
"الحسن الوجه.",
"كان شابًّا وسيمًا."
],
"278": [
"فَنَن",
"الغصن.",
"غرّد البلبل على فنن."
],
"279": [
"مُحْكَم",
"المتقن المضبوط الذي لا خلل فيه.",
"أغلق الباب إغلاقًا محكمًا."
],
"280": [
"مُرْتَبِك",
"المضطرب الذي اختلط عليه الأمر.",
"بدا مرتبكًا قبل الامتحان."
],
"281": [
"هِجَان",
"الإبل البيض الكريمة.",
"سارت الهجان في القافلة."
],
"282": [
"نَبْت",
"ما يخرج من الأرض من زرع.",
"خرج النبت بعد المطر."
],
"283": [
"مِطْرَقَة",
"أداة يُدق بها المسمار.",
"دقّ المسمار بالمطرقة."
],
"284": [
"شَجَا",
"أحزن وهيّج الشوق.",
"شجاه صوت الحمام."
],
"285": [
"هَجِير",
"شدة الحرّ وقت الظهيرة.",
"ساروا في الهجير."
],
"286": [
"أَكَاذِيب",
"جمع أكذوبة، وهي الكذبة.",
"لا يصدّق الأكاذيب."
],
"287": [
"مِثَال",
"النموذج الذي يُحتذى، أو ما يُذكر للتوضيح.",
"ضرب مثالًا ليشرح الفكرة."
],
"288": [
"زَهَا",
"أشرق وتلألأ، أو تكبّر.",
"زها الروض بالأزهار."
],
"289": [
"مِقْلَاة",
"إناء يُقلى فيه الطعام.",
"قلى البيض في المقلاة."
],
"290": [
"كَلَل",
"التعب والإعياء.",
"عمل بلا كلل ولا ملل."
],
"291": [
"صَارِم",
"السيف القاطع، والحازم الشديد.",
"كان قاضيًا صارمًا."
],
"292": [
"رِمْث",
"شجر صحراوي ترعاه الإبل.",
"رعت الإبل الرمث."
],
"293": [
"فَخَامَة",
"العظمة والفخر في الهيئة.",
"أعجبته فخامة القصر."
],
"294": [
"نَفَل",
"نبات بري زهره أصفر طيب الرائحة.",
"امتلأ الوادي بالنفل."
],
"295": [
"نُمُوّ",
"الزيادة والكِبَر شيئًا فشيئًا.",
"نموّ النبات يحتاج إلى ماء وضوء."
],
"296": [
"غَضًا",
"شجر صحراوي يبقى جمره طويلًا.",
"اشتعل جمر الغضا."
],
"297": [
"بَاقَة",
"مجموعة من الزهور مربوطة معًا.",
"أهداها باقةَ ورد."
],
"298": [
"مَعِين",
"الماء الجاري الظاهر.",
"شرب من ماءٍ معين."
],
"299": [
"كَتِيبَة",
"جماعة من الجيش.",
"تقدّمت الكتيبة نحو الحدود."
],
"300": [
"أَفَلَ",
"غاب، ويوصف به النجم والقمر.",
"أفل القمر قبيل الفجر."
],
"301": [
"يَرَاع",
"القلم.",
"خطّ بيراعه قصيدة."
],
"302": [
"جَرِيد",
"سعف النخل إذا جُرّد من ورقه.",
"صنعوا سقفًا من الجريد."
],
"303": [
"سُبُل",
"جمع سبيل، وهو الطريق.",
"تعدّدت سبل النجاح."
],
"304": [
"تَعَاوُن",
"العمل معًا لتحقيق هدف.",
"بالتعاون نجح المشروع."
],
"305": [
"مُتْقِن",
"الذي يُحسن عمله ويُجيده.",
"كان صانعًا متقنًا."
],
"306": [
"يَافِع",
"الغلام الذي قارب البلوغ.",
"صار فتًى يافعًا."
],
"307": [
"أَنِيس",
"الرفيق الذي يُؤنس.",
"الكتاب أنيس الوحدة."
],
"308": [
"نَهِلَ",
"شرب أول مرة، ويُستعار لأخذ العلم.",
"نهل من علم أستاذه."
],
"309": [
"تَعَابِير",
"ما يُظهره الوجه أو الكلام من معانٍ.",
"ظهرت على وجهه تعابير الدهشة."
],
"310": [
"انْعِدَام",
"الغياب التام للشيء.",
"سبّب انعدام المطر جفافًا."
],
"311": [
"تَيَّار",
"الجريان القوي للماء أو الهواء أو الكهرباء.",
"جرف التيارُ القارب."
],
"312": [
"نِيَام",
"جمع نائم.",
"دخل بهدوء والأطفال نيام."
],
"313": [
"وِفَاق",
"الاتفاق والانسجام.",
"عاشوا في وفاقٍ ومحبة."
],
"314": [
"يَانِع",
"الناضج من الثمر.",
"قطف الثمر اليانع."
],
"315": [
"مِغْوَار",
"الشجاع الكثير الإقدام.",
"كان فارسًا مغوارًا."
],
"316": [
"عِنَاق",
"الضمّ بين الذراعين.",
"ودّعه بعناقٍ طويل."
],
"317": [
"كَرَوَان",
"طائر حسن الصوت.",
"سمع صوت الكروان في الليل."
],
"318": [
"قَفْر",
"الأرض الخالية من الماء والناس.",
"مرّوا بأرضٍ قفر."
],
"319": [
"رَبْوَة",
"الأرض المرتفعة.",
"بنى بيته على ربوة."
],
"320": [
"سِرْوَال",
"لباس يغطي الساقين.",
"اشترى سروالًا جديدًا."
],
"321": [
"اضْطِرَاب",
"عدم الاستقرار والانتظام.",
"شعر باضطراب قبل الامتحان."
],
"322": [
"رَمَاد",
"ما يبقى من الشيء بعد احتراقه.",
"ذرّت الريح الرماد."
],
"323": [
"كَيْد",
"المكر والحيلة لإيقاع الأذى.",
"سلم من كيد أعدائه."
],
"324": [
"ابْتِكَار",
"الإتيان بشيء جديد لم يُسبق إليه.",
"فاز الطالب بجائزة الابتكار."
],
"325": [
"سَنَد",
"ما يُستند إليه، والمُعين.",
"كان أخوه سندَه في الشدائد."
],
"326": [
"حَارَة",
"الحيّ الصغير من المدينة.",
"لعب الأطفال في الحارة."
],
"327": [
"مَحَقّ",
"صاحب الحق.",
"أنت محقّ في رأيك."
],
"328": [
"حَضَارَة",
"ما يبلغه الناس من رُقيّ في العلم والعمران والأخلاق.",
"تركت الحضارات القديمة آثارًا عظيمة."
],
"329": [
"تَسَرُّب",
"خروج الشيء قليلًا قليلًا من مكان، كتسرب الماء.",
"أصلح السبّاك تسرّب الماء."
],
"330": [
"سَمِير",
"من يُحادثك في الليل.",
"الكتاب خير سمير."
],
"331": [
"بَهِيّ",
"الحسن المشرق.",
"كان منظرًا بهيًّا."
],
"332": [
"سِرَاج",
"المصباح.",
"أوقد السراج في الليل."
],
"333": [
"مُتَّسِخ",
"غير النظيف.",
"غسل ثوبه المتّسخ."
],
"334": [
"سَلْوَة",
"ما يُسلّي الحزين ويُذهب همّه.",
"كان الكتاب سلوته في الغربة."
],
"335": [
"يَسْبِق",
"يتقدّم غيره ويصل قبله.",
"يسبق أخاه إلى المدرسة."
],
"336": [
"دَهْر",
"الزمن الطويل.",
"مرّ دهرٌ على الحادثة."
],
"337": [
"تَعَامُل",
"المعاملة بين الناس في البيع والشراء والأخلاق.",
"حسن التعامل يكسب القلوب."
],
"338": [
"كَمِين",
"المكان الذي يختبئ فيه من يريد مفاجأة خصمه.",
"نصب الجنود كمينًا."
],
"339": [
"مَوْجَة",
"ما يرتفع من ماء البحر.",
"ارتفعت الموجة عاليًا."
],
"340": [
"تَسَلَّقَ",
"صعد شيئًا عاليًا متمسكًا به.",
"تسلّق الجبل."
],
"341": [
"كُومَة",
"ما اجتمع من الأشياء بعضها فوق بعض.",
"جمع كومةً من الحطب."
],
"342": [
"مُزْنَة",
"السحابة الممطرة.",
"ظلّلتهم مزنة."
],
"343": [
"أَرِيج",
"الرائحة الطيبة.",
"فاح أريج الياسمين."
],
"344": [
"حَمِيَّة",
"الأنفة والغضب للحق.",
"هبّ بحميّة يدافع عن أخيه."
],
"345": [
"اسْتِخْرَاج",
"إخراج الشيء من باطنه.",
"يحتاج استخراج النفط إلى آلات ضخمة."
],
"346": [
"تَعْدَاد",
"عدّ الناس أو الأشياء.",
"أُجري تعداد السكان."
],
"347": [
"سُتْرَة",
"لباس يُلبس فوق القميص.",
"لبس سترة في الشتاء."
],
"348": [
"مِلْيُون",
"ألف ألف.",
"يسكن المدينة مليون إنسان."
],
"349": [
"وَهْن",
"الضعف.",
"أصابه الوهن من التعب."
],
"350": [
"اسْتِدْعَاء",
"طلب حضور شخص.",
"تلقّى استدعاءً للاجتماع."
],
"351": [
"فَصِيل",
"ولد الناقة إذا فُصل عن أمه.",
"لحق الفصيل بأمه."
],
"352": [
"غَلَس",
"ظلمة آخر الليل.",
"خرجوا في الغلس."
],
"353": [
"مُنْتَدَيَات",
"جمع منتدى، وهو مكان اجتماع الناس للحديث.",
"تناقشوا في المنتديات."
],
"354": [
"مَتْن",
"ظهر الشيء، أو أصل الكلام في الكتاب.",
"صعد المسافرون على متن الطائرة."
],
"355": [
"يَجْلِب",
"يأتي بالشيء.",
"يجلب الماء من البئر."
],
"356": [
"نَزِيف",
"خروج الدم من الجرح.",
"أوقف الطبيب النزيف."
],
"357": [
"طَلَاقَة",
"البشاشة، وسهولة الكلام وسرعته.",
"تحدّث بطلاقة."
],
"358": [
"نِسَاء",
"جمع امرأة من غير لفظها.",
"اجتمعت النساء في الحفل."
],
"359": [
"سِنَان",
"رأس الرمح الحادّ.",
"لمع سنان الرمح."
],
"360": [
"كَسْب",
"الربح وما يحصّله الإنسان بعمله.",
"طلب الكسب الحلال."
],
"361": [
"ضَال",
"نوع من السدر البري.",
"استظلّوا بشجرة ضال."
],
"362": [
"أَدِيم",
"وجه الأرض، والجلد.",
"انتشرت الخضرة على أديم الأرض."
],
"363": [
"وَطَن",
"المكان الذي يعيش فيه الإنسان وينتمي إليه.",
"حبّ الوطن في القلب."
],
"364": [
"يُمْلِي",
"يقول الكلام ليكتبه غيره.",
"يُملي المعلّم الدرس على الطلاب."
],
"365": [
"تَجْمِيع",
"ضمّ الأشياء المتفرقة بعضها إلى بعض.",
"أنهى تجميع القطع."
],
"366": [
"اسْتَجَارَ",
"طلب الحماية.",
"استجار الغريب بالقبيلة."
],
"367": [
"تُرَاث",
"ما خلّفه الأجداد من عادات وفنون وآثار.",
"حافظ على تراث بلده."
],
"368": [
"وَكِيل",
"من يُفوَّض إليه القيام بأمر غيره.",
"عيّن وكيلًا عنه في البيع."
],
"369": [
"تُرَاب",
"ما نعم من سطح الأرض.",
"غطّى الترابُ الطريق."
],
"370": [
"سُبَات",
"النوم العميق الطويل.",
"تدخل بعض الحيوانات في سبات طوال الشتاء."
],
"371": [
"حَاسِم",
"القاطع الذي يُنهي الأمر.",
"اتخذ قرارًا حاسمًا."
],
"372": [
"مُحْتَوَيَات",
"ما يحويه الشيء.",
"فحص محتويات الصندوق."
],
"373": [
"تَعْلِيمَات",
"الإرشادات التي تبيّن طريقة العمل.",
"اتّبع تعليمات الطبيب."
],
"374": [
"مُسِنّ",
"الكبير في السن.",
"ساعد رجلًا مسنًّا على عبور الطريق."
],
"375": [
"سَائِل",
"ما يجري مثل الماء، أو من يسأل.",
"شرب سائلًا دافئًا."
],
"376": [
"سَبْت",
"اليوم الذي بعد الجمعة.",
"نلتقي يوم السبت."
],
"377": [
"سُهَاد",
"الأرق وذهاب النوم.",
"قضى ليله في سهاد."
],
"378": [
"سَرَاب",
"ما يُرى في الصحراء وقت الحر كأنه ماء.",
"ظنّ السراب ماءً."
],
"379": [
"سُيُوف",
"جمع سيف.",
"لمعت السيوف في الشمس."
],
"380": [
"مَارَاثُون",
"سباق جري لمسافة طويلة جدًّا.",
"شارك في الماراثون."
],
"381": [
"نَزْر",
"القليل.",
"لم يبق إلا نزرٌ يسير."
],
"382": [
"كِلَاسِيكِيّ",
"القديم الأصيل الذي يُعدّ نموذجًا.",
"يحب السيارات الكلاسيكية."
],
"383": [
"تَجَاوُب",
"التفاعل مع الشيء والاستجابة له.",
"لقيت الفكرة تجاوبًا كبيرًا."
],
"384": [
"اسْتِجَابَة",
"الردّ والتلبية.",
"كانت استجابته سريعة."
],
"385": [
"غَاف",
"شجر صحراوي دائم الخضرة.",
"جلسوا تحت ظل الغاف."
],
"386": [
"ابْتَعَدَ",
"ذهب بعيدًا.",
"ابتعد عن مصدر الخطر."
],
"387": [
"كَاهِل",
"ما بين الكتفين من الظهر.",
"حمل الأمانة على كاهله."
],
"388": [
"مِغْنَاطِيس",
"معدن يجذب الحديد.",
"جذب المغناطيس الدبابيس."
],
"389": [
"وَمِيض",
"لمعان خاطف.",
"رأى وميض البرق."
],
"390": [
"رِوَاق",
"الممرّ المسقوف.",
"جلسوا في رواق البيت."
],
"391": [
"جِنَاس",
"تشابه كلمتين في اللفظ واختلافهما في المعنى.",
"في «شربتُ من العين حتى دمعت العين» جناس."
],
"392": [
"اتَّقَدَ",
"اشتعل وتوهّج.",
"اتّقد الجمر في الموقد."
],
"393": [
"جِيَاد",
"جمع جواد، وهي الخيل الأصيلة.",
"تسابقت الجياد في الميدان."
],
"394": [
"بَنَان",
"أطراف الأصابع.",
"أشار ببنانه."
],
"395": [
"مَرْتَع",
"المرعى الخصب.",
"كانت الروضة مرتعًا للإبل."
],
"396": [
"صَافِي",
"الخالص من الكدر.",
"كان الماء صافيًا."
],
"397": [
"انْتِخَاب",
"اختيار شخص بالتصويت.",
"جرى انتخاب رئيس للنادي."
],
"398": [
"اصْطِنَاع",
"صنع الشيء، أو التكلّف وإظهار ما ليس حقيقيًّا.",
"ابتسم دون اصطناع."
],
"399": [
"شَرِيعَة",
"مورد الماء الذي يُستقى منه.",
"وردت الإبل الشريعة."
],
"400": [
"الْتِمَاس",
"الطلب، و«التماس العذر» أي البحث عن عذر للآخر.",
"التماس العذر للناس من حسن الخلق."
]
